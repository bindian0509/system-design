# Airflow Environment Variables
# Copy this file to .env: cp env.example .env

# Airflow UID - set to your user ID to avoid permission issues
# On Linux, run: echo $(id -u)
# On macOS, this default (50000) works fine
AIRFLOW_UID=50000

# Optional: Add extra pip packages
_PIP_ADDITIONAL_REQUIREMENTS=pandas pyarrow requests

