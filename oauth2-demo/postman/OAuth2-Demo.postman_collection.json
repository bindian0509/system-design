{
  "info": {
    "name": "OAuth 2.0 Demo",
    "description": "Complete OAuth 2.0 flow testing collection for Spring Authorization Server demo.\n\n## Flows Included:\n1. **Client Credentials** - Machine-to-machine authentication\n2. **Authorization Code** - Web application authentication\n3. **Authorization Code + PKCE** - SPA/Mobile authentication\n4. **Refresh Token** - Token renewal\n5. **Resource Server** - Protected API access\n\n## Setup:\n1. Import this collection\n2. Import the environment file\n3. Run services with `./run.sh`\n4. Execute requests in order",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "auth_server_url",
      "value": "http://localhost:9001"
    },
    {
      "key": "resource_server_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    }
  ],
